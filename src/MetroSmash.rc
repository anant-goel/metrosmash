// MetroSmash.rc — Windows EXE resources
// Compiled by CMake via target_sources(); no manual rc.exe invocation needed.

#include <windows.h>

// ── Application icon ─────────────────────────────────────────────────────────
IDI_ICON1  ICON  "MetroSmash.ico"

// ── Version / publisher info (shown in Explorer Properties → Details) ────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,0,0
PRODUCTVERSION  3,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // Language: US English, Code page: Unicode
        BEGIN
            VALUE "CompanyName",      "Anant Goel\0"
            VALUE "FileDescription",  "Metro Smash — Ultimate Destruction Sandbox\0"
            VALUE "FileVersion",      "3.0.0.0\0"
            VALUE "InternalName",     "MetroSmash\0"
            VALUE "LegalCopyright",   "Copyright (C) 2025 Anant Goel\0"
            VALUE "OriginalFilename", "MetroSmash.exe\0"
            VALUE "ProductName",      "Metro Smash\0"
            VALUE "ProductVersion",   "3.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
